# Copy to .env and fill in real values before deploying.

# --- Database -----------------------------------------------------------------
POSTGRES_USER=turf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=turfmanager
DATABASE_URL=postgresql+psycopg://turf:change-me@db:5432/turfmanager

# --- Auth -----------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- App --------------------------------------------------------------------
ENVIRONMENT=production
# Both PWAs are separate origins — the backend must allow both.
CORS_ORIGINS=["https://your-turf-domain.com","https://owner.your-turf-domain.com"]
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_CURRENCY=BDT

# --- Frontend (build-time) ---------------------------------------------------
# Both apps default to the relative path "/api/v1", which each app's own Caddy site
# block proxies to the same backend — usually you don't need to set this at all.
# VITE_API_BASE_URL=https://your-turf-domain.com/api/v1

# --- Caddy --------------------------------------------------------------------
DOMAIN=your-turf-domain.com
OWNER_DOMAIN=owner.your-turf-domain.com
