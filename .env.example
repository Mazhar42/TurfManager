# Production settings for docker-compose.yml. On the server: copy to `.env` (next to
# docker-compose.yml), fill in every "change-me", and keep it out of git (it already is).
# Generate secrets with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# --- Domains (point both DNS A records at the server before the first start) -------------
DOMAIN=turf.example.com
OWNER_DOMAIN=owner.turf.example.com

# --- Database ----------------------------------------------------------------------------
POSTGRES_USER=turf
POSTGRES_DB=turfmanager
# Letters and digits only — it is embedded in the database URL.
POSTGRES_PASSWORD=change-me

# --- API -----------------------------------------------------------------------------------
# 32+ random characters. The API refuses to start in production with a placeholder.
JWT_SECRET=change-me
ENVIRONMENT=production
# Both PWAs are separate origins — list both, as a JSON array.
CORS_ORIGINS=["https://turf.example.com","https://owner.turf.example.com"]
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
LOG_LEVEL=INFO
# uvicorn worker processes. 2 suits a 1–2 vCPU VPS.
WEB_CONCURRENCY=2
# Optional: report unhandled errors to Sentry / GlitchTip. Leave empty to only log them.
SENTRY_DSN=

# --- Backups -------------------------------------------------------------------------------
# Nightly pg_dump into ./backups on the server, pruned after BACKUP_KEEP_DAYS.
BACKUP_SCHEDULE=30 3 * * *
BACKUP_TZ=Asia/Dhaka
BACKUP_KEEP_DAYS=14
# Off-server copy (strongly recommended — a backup on the same disk dies with the disk).
# Any rclone remote works; configure it entirely with RCLONE_CONFIG_<NAME>_* variables.
# Example: Cloudflare R2 / Backblaze B2 / any S3-compatible bucket, remote named OFFSITE:
# BACKUP_RCLONE_REMOTE=OFFSITE:my-turf-backups/db
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_RCLONE_REMOTE=

# --- Images (managed by deploy/deploy.sh — normally leave alone) ---------------------------
IMAGE_REGISTRY=ghcr.io/mazhar42
# IMAGE_TAG is written here by each deploy.
